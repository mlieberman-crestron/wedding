# Copy to .env (cp .env.example .env) and adjust. Used by docker-compose.yml only;
# the Portainer stack has these values inline.

# Port on the NAS that the app is reachable on: http://192.168.2.40:HOST_PORT
HOST_PORT=8088

# Free-form label shown on the page (dev, test, prod ...)
APP_ENV=dev

# Shown on the page
EVENT_NAME=Casey & Dustin
